// firestore.rules
// Copia estas reglas en Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: lectura pública, escritura solo admins autenticados
    match /productos/{productoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Postulaciones: cualquiera puede crear (formulario público), solo admins pueden leer/editar
    match /postulaciones/{postId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
