// storage.rules
// Copia estas reglas en Firebase Console → Storage → Rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes de productos: solo admins pueden subir/eliminar, lectura pública
    match /productos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Hojas de vida: el formulario puede subir, solo admins pueden leer
    match /hojas-de-vida/{allPaths=**} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }
  }
}
